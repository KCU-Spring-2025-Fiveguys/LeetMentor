{
  "manifest_version": 3,
  "name": "Leet Mentor",
  "version": "1.0",
  "description": "An AI-powered Chrome extension that tutors coding questions",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "html/popup.html"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
